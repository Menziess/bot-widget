#!/bin/sh
# The unit tests of the committed state (HEAD) on Linux in Docker, set up like the ubuntu job in ci.yml.
set -eu
src=$(mktemp -d /tmp/bw-linux.XXXXXX)
trap 'rm -rf "$src"' EXIT
git -C "$(dirname "$0")/.." archive HEAD | tar -x -C "$src"
docker run --rm -v "$src":/src:ro python:3.12 bash -c '
  set -eo pipefail
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq >/dev/null 2>&1
  apt-get install -y -qq --no-install-recommends libegl1 libgl1 libxkbcommon0 libdbus-1-3 libxcb-cursor0 >/dev/null 2>&1
  cp -r /src /work && cd /work
  pip install -q --root-user-action=ignore --disable-pip-version-check . >/dev/null
  QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -t . 2>&1 | grep -E "^(FAIL|ERROR):|^Ran |^OK|^FAILED"
  cd tests && QT_QPA_PLATFORM=offscreen python -c "import botwidget.qt_ui.app" && echo "The Qt layer imports"
'
